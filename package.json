{
  "name": "cip-platform",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --ui=tui",
    "dev:api": "turbo run dev --filter @cip/api",
    "dev:web": "turbo run dev --filter @cip/web",
    "generate": "turbo run generate",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check:docs": "tsx scripts/checks/docs.ts",
    "check:rules": "tsx scripts/checks/rules.ts",
    "check:protected": "tsx scripts/checks/protected.ts",
    "audit:drift": "pnpm check:docs && pnpm check:rules && pnpm check:protected",
    "prepare": "husky",
    "check:changed": "tsx scripts/checks/changed.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@types/node": "^26.6.6",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx,json,jsonc,md,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}

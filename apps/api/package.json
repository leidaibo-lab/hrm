{
  "name": "@cip/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "generate": "prisma generate",
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "typecheck:ci": "tsc -p tsconfig.ci.json --noEmit",
    "export:openapi": "tsx --tsconfig tsconfig.ci.json src/testing/openapi.helper.ts",
    "test:unit": "vitest run --exclude src/__tests__/persistence.spec.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.84",
    "@cip/shared": "workspace:*",
    "@mastra/core": "1.83.0",
    "@mastra/memory": "1.41.1",
    "@mastra/pg": "1.36.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bullmq": "^6.5.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/testing": "^12.3.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}

# 日志级别（生产部署注入 info）
LOG_LEVEL=debug

# 日志美化：默认 JSON 结构化；本地开发注入 true 走 pino-pretty 单行彩色输出
LOG_PRETTY=false

# Cookie Secure：生产（HTTPS）部署注入 true，cookie 仅随 HTTPS 发送
COOKIE_SECURE=false

# 数据库连接（对应根目录 docker-compose.yml 的 postgres 服务；凭据属敏感值，仅经部署注入）
DATABASE_URL=postgresql://cip:change-me@localhost:5432/cip

# API 监听端口
PORT=3011

# Redis 连接（会话存储）
REDIS_URL=redis://localhost:6379

# 凭据加密主密钥（ADR-0015）：AES-256-GCM 主密钥，32 字节的 base64 编码
# 生成方式：openssl rand -base64 32；仅经部署注入，禁止提交真实值
CREDENTIAL_MASTER_KEY=

# 会话有效期（秒），固定 TTL
SESSION_TTL_SECONDS=604800

# 本地注册开关（ADR-0010）：关闭时注册页与注册端点同步不可用
AUTH_REGISTRATION_ENABLED=true

# 注册邮箱域名白名单：空 = 不限制；非空时仅允许列表内域注册。逗号分隔
AUTH_ALLOWED_EMAIL_DOMAINS=

# 允许的浏览器来源：CORS 白名单与 CSRF Origin 校验共用，逗号分隔
AUTH_ALLOWED_ORIGINS=http://localhost:3010

# 出站私网豁免主机（ADR-0038）：默认空 = 环回/私网出站全部阻断；本地供应商联调时显式注入精确主机名或 IP
OUTBOUND_ALLOW_PRIVATE_HOSTS=

# 初始管理员（prisma db seed 使用；生产务必改强密码）
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-strong

# 飞书事件订阅校验 token（空 = 不校验，仅开发；生产必须注入）
LARK_VERIFICATION_TOKEN=
LARK_API_BASE=https://open.feishu.cn

# 出站发送限速：每来源实例每秒最多发送条数（默认 10）
OUTBOUND_RATE_PER_SECOND=10

# 入站事件限速：每来源实例每秒最多接收条数（默认 20；超限由来源重试）
INGRESS_RATE_PER_SECOND=20

# 内部契约共享令牌（空 = 内部接口未启用，仅开发；生产必须注入）
INTERNAL_API_TOKEN=
INTERNAL_API_SCOPES=*
AGENTIC_RETENTION_APPLY=false

# 飞书应用凭据（出站发送用；仅经部署注入，禁止提交真实值）
LARK_APP_ID=
LARK_APP_SECRET=
LARK_ENCRYPT_KEY=
